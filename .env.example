# Copy this file to .env.development and fill in the values.
# Next.js auto-loads .env.development during `npm run dev`.

# Base URL for the Axios client (app/shared/http/axios.ts).
# The Pokémon feature points this at the public PokeAPI.
NEXT_PUBLIC_API_BASE_URL=https://pokeapi.co/api/v2/

# Intended for the encrypted local storage layer (app/shared/storage).
# Not yet wired up — the /internal/storage endpoint it depends on
# isn't implemented in this template yet.
STORAGE_ENCRYPTION_KEY=

# Present for environment identification. Not currently read anywhere
# in the app.
ENVIRONMENT=
